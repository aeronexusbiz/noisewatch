{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/noise.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/noise/:path*", "destination": "https://macmini.tail95ff38.ts.net/noise/:path*" },
    { "source": "/rwy/flow", "destination": "https://macmini.tail95ff38.ts.net/rwy/flow" },
    { "source": "/partner/acft", "destination": "https://macmini.tail95ff38.ts.net/partner/acft" },
    { "source": "/vworld/:path*", "destination": "https://macmini.tail95ff38.ts.net/vworld/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
    ] }
  ]
}
